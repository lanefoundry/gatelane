{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/engine" },
    { "path": "packages/mode-red-team" },
    { "path": "packages/mode-backtest" },
    { "path": "apps/worker" }
  ]
}
