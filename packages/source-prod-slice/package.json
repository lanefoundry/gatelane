    },
    "./promotion-decision": {
      "types": "./dist/promotion-decision.d.ts",
      "import": "./dist/promotion-decision.js"
    },
    "./signed-report": {
      "types": "./dist/signed-report.d.ts",
      "import": "./dist/signed-report.js"
    },
    "./canary-orchestrator": {
      "types": "./dist/canary-orchestrator.d.ts",
