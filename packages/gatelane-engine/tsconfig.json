{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@lanefoundry/gatelane-sdk": ["../gatelane-sdk/dist/index.d.ts"],
      "@lanefoundry/gatelane-sdk/*": ["../gatelane-sdk/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["../gatelane-sdk/**"]
}